<Page
    x:Class="OmniKey.Windows.Views.Pages.LicensePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Setup"
    Background="Transparent"
    d:DesignHeight="700"
    d:DesignWidth="980"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontFamily" Value="{StaticResource OK.FontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource OK.Font.CaptionSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Nord.SecondaryTextBrush}" />
        </Style>

        <!--
            Hosting-mode switch, restyled as a segmented control.

            The stock WPF TabControl template renders Win32-era notched tabs:
            a 1px system-grey outline with almost no selected/unselected
            contrast, which on the dark Nord surface left the two modes
            near-invisible and read as chrome rather than a choice the user is
            being asked to make. A filled accent chip inside a recessed track
            is unambiguous at a glance and matches the pill vocabulary already
            used across the composer and session pages.
        -->
        <Style x:Key="OnboardingTabItem" TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource OK.FontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource OK.Font.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Nord.SecondaryTextBrush}" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="Chip"
                            Padding="20,10"
                            Background="Transparent"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover before selection so the selected chip's
                                 accent fill is not overpainted by the hover
                                 wash when the pointer rests on it. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Nord.HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource Nord.PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Nord.AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Recessed track. UniformGrid (not the default
                                 TabPanel) so both chips take the width of the
                                 wider label — otherwise "SaaS" renders as a
                                 stub next to "Self-hosted (free)" and the pair
                                 stops reading as one switch. -->
                            <Border
                                Grid.Row="0"
                                Padding="4"
                                HorizontalAlignment="Center"
                                Background="{StaticResource Nord.EditorBackgroundBrush}"
                                BorderBrush="{StaticResource Nord.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <UniformGrid IsItemsHost="True" Rows="1" />
                            </Border>
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Grid.Row="1"
                                ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,20">
        <Grid Visibility="{Binding IsCheckingSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,14,0,0"
                    FontFamily="{StaticResource OK.FontFamily}"
                    FontSize="{StaticResource OK.Font.Body}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Nord.PrimaryTextBrush}"
                    Text="Checking local OmniKey setup..." />
            </StackPanel>
        </Grid>

        <!-- First-run local onboarding.

             HorizontalAlignment is Stretch, not Center, on purpose. With
             Center the card is sized to its content, so switching tabs
             resized the whole card: the self-hosted pane's 620px-capped
             paragraphs pushed it out to the 820 cap, while the much shorter
             SaaS pane let it collapse inward — the card visibly snapped
             narrower mid-onboarding. Stretch makes the width a function of
             the available space instead (min(available, 820)), so content no
             longer drives it and the card holds still across tab switches.
             WPF arranges a Stretch element that has been clamped by MaxWidth
             using the same centering offset as Center, so this stays centered
             and still shrinks gracefully on a narrow window. -->
        <Border
            MaxWidth="820"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{StaticResource Nord.PanelBackgroundBrush}"
            CornerRadius="14"
            Visibility="{Binding ShowOnboarding, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="22"
                    Direction="270"
                    Opacity="0.45"
                    ShadowDepth="6"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,28,0,20"
                    HorizontalAlignment="Center">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Foreground="{StaticResource Nord.AccentBrush}"
                        Symbol="Server24" />
                    <TextBlock
                        Margin="0,12,0,4"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource OK.FontFamily}"
                        FontSize="{StaticResource OK.Font.Title}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Nord.PrimaryTextBrush}"
                        Text="Set up OmniKey" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource OK.FontFamily}"
                        FontSize="{StaticResource OK.Font.Body}"
                        Foreground="{StaticResource Nord.SecondaryTextBrush}"
                        Text="Use the free local daemon with your own provider key." />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Height="1"
                    Background="{StaticResource Nord.BorderBrush}" />

                <StackPanel Grid.Row="2" Margin="24,20,24,24">
                    <TabControl
                        MinHeight="330"
                        ItemContainerStyle="{StaticResource OnboardingTabItem}"
                        SelectedIndex="{Binding SelectedOnboardingTabIndex, Mode=TwoWay}"
                        Style="{StaticResource OnboardingTabControl}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Symbol="Server24" />
                                    <TextBlock VerticalAlignment="Center" Text="Self-hosted (free)" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0,18,0,0">
                                <StackPanel>
                                    <!-- Step rail. Centered as a group rather than
                                         pinned to both edges: a star-width spacer
                                         column used to shove "Install" hard left and
                                         "Configure" hard right, which read as two
                                         unrelated labels on a wide window. A fixed
                                         connector inside a centered StackPanel keeps
                                         the pair reading as one sequence at any width. -->
                                    <StackPanel
                                        Margin="0,0,0,18"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Border
                                            Width="24"
                                            Height="24"
                                            Background="{StaticResource Nord.AccentBrush}"
                                            CornerRadius="12">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource OK.FontFamily}"
                                                FontSize="{StaticResource OK.Font.CaptionSmall}"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="1" />
                                        </Border>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource OK.FontFamily}"
                                            FontSize="{StaticResource OK.Font.CaptionSmall}"
                                            FontWeight="SemiBold"
                                            Text="Install">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Nord.PrimaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigureStep}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Nord.SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border
                                            Width="48"
                                            Height="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Nord.BorderBrush}" />
                                        <!-- The "2" is nested inside its bullet and
                                             centered, matching step 1. It previously
                                             sat in an empty Border and was dragged back
                                             over it with Margin="-18,0,0,0", which put
                                             the glyph ~3px left of the circle's center. -->
                                        <Border
                                            Width="24"
                                            Height="24"
                                            Background="{StaticResource Nord.AccentBrush}"
                                            CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigureStep}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource OK.FontFamily}"
                                                FontSize="{StaticResource OK.Font.CaptionSmall}"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="2" />
                                        </Border>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource OK.FontFamily}"
                                            FontSize="{StaticResource OK.Font.CaptionSmall}"
                                            FontWeight="SemiBold"
                                            Text="Configure">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Nord.SecondaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigureStep}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Nord.PrimaryTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsInstallStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border
                                            Padding="14,12"
                                            Background="{StaticResource Nord.EditorBackgroundBrush}"
                                            BorderBrush="{StaticResource Nord.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Top"
                                                    FontSize="20"
                                                    Foreground="{StaticResource Nord.AccentBrush}"
                                                    Symbol="WindowConsole20" />
                                                <StackPanel>
                                                    <TextBlock
                                                        FontFamily="{StaticResource OK.FontFamily}"
                                                        FontSize="{StaticResource OK.Font.Headline}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource Nord.PrimaryTextBrush}"
                                                        Text="Install the local daemon tools" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        MaxWidth="620"
                                                        FontFamily="{StaticResource OK.FontFamily}"
                                                        FontSize="{StaticResource OK.Font.Caption}"
                                                        Foreground="{StaticResource Nord.SecondaryTextBrush}"
                                                        Text="OmniKey will check omnikey-cli and install or update it in the background."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button
                                                Grid.Column="0"
                                                Appearance="Primary"
                                                Command="{Binding InstallCliCommand}"
                                                Content="{Binding InstallCliButtonText}"
                                                Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                                            <ui:Button
                                                Grid.Column="2"
                                                Command="{Binding NextSetupCommand}"
                                                Content="Next"
                                                Icon="{ui:SymbolIcon Symbol=ArrowRight24}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsConfigureStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border
                                            Padding="14,12"
                                            Background="{StaticResource Nord.EditorBackgroundBrush}"
                                            BorderBrush="{StaticResource Nord.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Top"
                                                    FontSize="20"
                                                    Foreground="{StaticResource Nord.AccentBrush}"
                                                    Symbol="Key24" />
                                                <StackPanel>
                                                    <TextBlock
                                                        FontFamily="{StaticResource OK.FontFamily}"
                                                        FontSize="{StaticResource OK.Font.Headline}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource Nord.PrimaryTextBrush}"
                                                        Text="Connect an AI provider" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        MaxWidth="620"
                                                        FontFamily="{StaticResource OK.FontFamily}"
                                                        FontSize="{StaticResource OK.Font.Caption}"
                                                        Foreground="{StaticResource Nord.SecondaryTextBrush}"
                                                        Text="Your key is saved locally in %USERPROFILE%\.omnikey\config.json and read only by the local daemon."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Margin="0,18,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                    <TextBlock
                                                        Style="{StaticResource FieldLabel}"
                                                        Text="PROVIDER" />
                                                    <ComboBox
                                                        DisplayMemberPath="DisplayName"
                                                        FontFamily="{StaticResource OK.FontFamily}"
                                                        FontSize="13"
                                                        ItemsSource="{Binding ProviderOptions}"
                                                        SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" />
                                                </StackPanel>

                                                <Grid
                                                    Grid.Column="1"
                                                    Visibility="{Binding ShowOpenModelResponsesApi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="RESPONSES API" />
                                                        <TextBlock
                                                            FontFamily="{StaticResource OK.FontFamily}"
                                                            FontSize="{StaticResource OK.Font.CaptionSmall}"
                                                            Foreground="{StaticResource Nord.SecondaryTextBrush}"
                                                            Text="Enable only when your gateway supports /v1/responses."
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <ui:ToggleSwitch
                                                        Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        AutomationProperties.Name="Use Responses API"
                                                        IsChecked="{Binding ResponsesApiEnabledInput, Mode=TwoWay}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock
                                                Margin="0,14,0,0"
                                                Style="{StaticResource FieldLabel}"
                                                Text="API KEY" />
                                            <ui:TextBox
                                                FontFamily="{StaticResource OK.MonoFontFamily}"
                                                FontSize="13"
                                                PlaceholderText="{Binding SelectedProvider.KeyPlaceholder}"
                                                Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}" />

                                            <StackPanel Visibility="{Binding ShowOpenModelBaseUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    Margin="0,14,0,0"
                                                    Style="{StaticResource FieldLabel}"
                                                    Text="BASE URL (OPTIONAL)" />
                                                <ui:TextBox
                                                    FontFamily="{StaticResource OK.MonoFontFamily}"
                                                    FontSize="13"
                                                    PlaceholderText="http://localhost:8000/v1"
                                                    Text="{Binding BaseUrlInput, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontFamily="{StaticResource OK.FontFamily}"
                                                    FontSize="{StaticResource OK.Font.CaptionSmall}"
                                                    Foreground="{StaticResource Nord.SecondaryTextBrush}"
                                                    Text="Leave blank for the default OpenAI-compatible gateway."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border
                                            Margin="0,16,0,0"
                                            Padding="14,12"
                                            Background="{StaticResource Nord.EditorBackgroundBrush}"
                                            BorderBrush="{StaticResource Nord.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding ShowWindowsDaemonInstructions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock
                                                    FontFamily="{StaticResource OK.FontFamily}"
                                                    FontSize="{StaticResource OK.Font.Caption}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource Nord.PrimaryTextBrush}"
                                                    Text="Start the daemon manually" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontFamily="{StaticResource OK.FontFamily}"
                                                    FontSize="{StaticResource OK.Font.CaptionSmall}"
                                                    Foreground="{StaticResource Nord.SecondaryTextBrush}"
                                                    Text="Open Admin Terminal launches an elevated PowerShell and runs this for you. To do it yourself, open PowerShell as Administrator and run:"
                                                    TextWrapping="Wrap" />
                                                <TextBox
                                                    Margin="0,8,0,8"
                                                    Padding="8,6"
                                                    Background="{StaticResource Nord.WindowBackgroundBrush}"
                                                    BorderBrush="{StaticResource Nord.BorderBrush}"
                                                    BorderThickness="1"
                                                    FontFamily="{StaticResource OK.MonoFontFamily}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource Nord.PrimaryTextBrush}"
                                                    IsReadOnly="True"
                                                    Text="{Binding WindowsDaemonCommand}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button
                                                        Appearance="Primary"
                                                        Command="{Binding OpenAdminTerminalCommand}"
                                                        Content="Open Admin Terminal"
                                                        Icon="{ui:SymbolIcon Symbol=WindowConsole20}"
                                                        Visibility="{Binding ShowElevatedTerminalFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource OK.FontFamily}"
                                                        FontSize="{StaticResource OK.Font.CaptionSmall}"
                                                        Foreground="{StaticResource Nord.SecondaryTextBrush}"
                                                        Text="Then click Check Daemon."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button
                                                Grid.Column="0"
                                                Command="{Binding BackSetupCommand}"
                                                Content="Back"
                                                Icon="{ui:SymbolIcon Symbol=ArrowLeft24}" />
                                            <ui:ProgressRing
                                                Grid.Column="2"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,10,0"
                                                IsIndeterminate="True"
                                                Visibility="{Binding IsStartingDaemon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:Button
                                                Grid.Column="3"
                                                Appearance="Primary"
                                                Command="{Binding StartDaemonCommand}"
                                                Content="{Binding StartDaemonButtonText}"
                                                Icon="{ui:SymbolIcon Symbol=Play24}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Symbol="Cloud24" />
                                    <TextBlock VerticalAlignment="Center" Text="SaaS" />
                                </StackPanel>
                            </TabItem.Header>
                            <StackPanel Margin="0,18,0,0">
                                <Border
                                    Padding="14,12"
                                    Background="{StaticResource Nord.EditorBackgroundBrush}"
                                    BorderBrush="{StaticResource Nord.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Top"
                                            FontSize="20"
                                            Foreground="{StaticResource Nord.AccentAmberBrush}"
                                            Symbol="ErrorCircle24" />
                                        <StackPanel>
                                            <TextBlock
                                                FontFamily="{StaticResource OK.FontFamily}"
                                                FontSize="{StaticResource OK.Font.Headline}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource Nord.PrimaryTextBrush}"
                                                Text="SaaS is unavailable" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                MaxWidth="620"
                                                FontFamily="{StaticResource OK.FontFamily}"
                                                FontSize="{StaticResource OK.Font.Caption}"
                                                Foreground="{StaticResource Nord.SecondaryTextBrush}"
                                                Text="Omnikey is not offering SaaS right now; please run the local daemon."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Margin="0,18,0,0"
                                    Style="{StaticResource FieldLabel}"
                                    Text="LICENSE KEY" />
                                <ui:TextBox
                                    IsEnabled="False"
                                    PlaceholderText="SaaS activation is currently disabled" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <StackPanel
                        Margin="0,18,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{Binding StatusBrush}"
                            Symbol="Info24" />
                        <TextBlock
                            MaxWidth="650"
                            FontFamily="{StaticResource OK.FontFamily}"
                            FontSize="{StaticResource OK.Font.CaptionSmall}"
                            Foreground="{Binding StatusBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Existing self-hosted notice for already-configured local installs -->
        <Border
            MaxWidth="520"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource Nord.PanelBackgroundBrush}"
            CornerRadius="14"
            Visibility="{Binding ShowSelfHostedNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,28,0,20"
                    HorizontalAlignment="Center">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Foreground="{StaticResource Nord.AccentGreenBrush}"
                        Symbol="Server24" />
                    <TextBlock
                        Margin="0,12,0,4"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource OK.FontFamily}"
                        FontSize="{StaticResource OK.Font.Title}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Nord.PrimaryTextBrush}"
                        Text="Self-hosted mode" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource OK.FontFamily}"
                        FontSize="{StaticResource OK.Font.Body}"
                        Foreground="{StaticResource Nord.SecondaryTextBrush}"
                        Text="No subscription key is required." />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Height="1"
                    Background="{StaticResource Nord.BorderBrush}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="24,20,24,24"
                    FontFamily="{StaticResource OK.FontFamily}"
                    FontSize="{StaticResource OK.Font.Caption}"
                    Foreground="{StaticResource Nord.SecondaryTextBrush}"
                    Text="OmniKey is configured to talk to your local backend and is ready to use."
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Legacy subscription activation for non-first-run cloud setups -->
        <Border
            MaxWidth="520"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource Nord.PanelBackgroundBrush}"
            CornerRadius="14"
            Visibility="{Binding ShowSubscriptionForm, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="22"
                    Direction="270"
                    Opacity="0.45"
                    ShadowDepth="6"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,28,0,20"
                    HorizontalAlignment="Center">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Foreground="{StaticResource Nord.AccentBrush}"
                        Symbol="Key24" />
                    <TextBlock
                        Margin="0,12,0,4"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource OK.FontFamily}"
                        FontSize="{StaticResource OK.Font.Title}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Nord.PrimaryTextBrush}"
                        Text="Activate OmniKey" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource OK.FontFamily}"
                        FontSize="{StaticResource OK.Font.Body}"
                        Foreground="{StaticResource Nord.SecondaryTextBrush}"
                        Text="Enter your subscription key to unlock all features." />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Height="1"
                    Background="{StaticResource Nord.BorderBrush}" />

                <StackPanel Grid.Row="2" Margin="24,20,24,24">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="SUBSCRIPTION KEY" />
                    <ui:TextBox
                        FontFamily="{StaticResource OK.MonoFontFamily}"
                        FontSize="13"
                        PlaceholderText="Paste your subscription key here"
                        Text="{Binding SubscriptionKey, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Margin="0,18,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <ui:ProgressRing
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsActivating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource OK.FontFamily}"
                            FontSize="{StaticResource OK.Font.CaptionSmall}"
                            Foreground="{Binding StatusBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Command="{Binding QuitCommand}"
                            Content="Quit" />
                        <ui:Button
                            Grid.Column="2"
                            Appearance="Primary"
                            Command="{Binding ActivateCommand}"
                            Content="Activate"
                            Icon="{ui:SymbolIcon Symbol=Checkmark24}"
                            IsDefault="True" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
