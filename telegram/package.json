{
  "name": "telegram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "test": "echo \"(no tests in this workspace)\" && exit 0",
    "lint": "eslint --config ../eslint.config.mjs \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "node-telegram-bot-api": "^0.67.0",
    "winston": "^3.19.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "@types/node-telegram-bot-api": "^0.64.15"
  }
}
