{
  "name": "omnikey-cli",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "version": "1.8.25",
  "description": "CLI for onboarding users to Omnikey AI and configuring OPENAI_API_KEY. Use pnpm for install/build.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omnikey": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && pnpm run copy-backend && pnpm run build:telegram-client",
    "start": "node dist/index.js",
    "copy-backend": "rm -rf backend-dist && mkdir -p backend-dist && cp -R ../api/dist/* backend-dist/",
    "build:telegram-client": "rm -rf telegram-client-dist && mkdir -p telegram-client-dist && cp -R ../telegram/dist/* telegram-client-dist/",
    "clean": "rm -rf dist backend-dist telegram-client-dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "lint": "eslint --config ../eslint.config.mjs \"src/**/*.ts\"",
    "test:types": "tsc --noEmit --skipLibCheck --esModuleInterop --strict --target ES2017 --module commonjs --moduleResolution node src/__tests__/skills.test.ts",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "cli",
    "omnikey",
    "onboarding",
    "openai"
  ],
  "author": "Gurinder Rawala",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@google-cloud/storage": "^9.0.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/diffs": "1.6.4",
    "axios": "^1.21.1",
    "commander": "^14.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.6",
    "cuid": "^3.0.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "inquirer": "^9.3.8",
    "jsonwebtoken": "^9.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^7.57.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "playwright-core": "^1.65.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "winston": "^3.19.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GurinderRawala/OmniKey-AI.git"
  },
  "files": [
    "dist",
    "backend-dist",
    "src",
    "README.md",
    "telegram-client-dist"
  ]
}
