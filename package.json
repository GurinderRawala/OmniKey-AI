{
  "name": "omnikey-ai-monorepo",
  "version": "1.6.0",
  "private": true,
  "description": "OmniKey AI monorepo containing the API, CLI, and Telegram workspaces. Use pnpm and Turborepo for install/build/start.",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "clean": "turbo run clean",
    "build:api": "turbo run build --filter=omnikey-ai-api",
    "build:telegram": "turbo run build --filter=telegram",
    "build:cli": "turbo run build --filter=omnikey-cli",
    "dev": "turbo run dev --filter=omnikey-ai-api --env-mode=loose",
    "dev:all": "turbo run dev --env-mode=loose",
    "start": "pnpm --filter omnikey-ai-api start",
    "test:types": "turbo run test:types",
    "test:tooling": "node --test scripts/tests/workspace.test.mjs",
    "test:cache": "node scripts/test-turbo-cache.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "turbo": "2.11.11"
  },
  "packageManager": "pnpm@10.34.9"
}
