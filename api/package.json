{
  "name": "omnikey-ai-api",
  "version": "1.8.22",
  "main": "dist/index.js",
  "description": "Omnikey AI backend API. Use pnpm for install/build/start.",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev:windows": "concurrently \"pnpm dev\" \"cd ../windows && dotnet run\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint --config ../eslint.config.mjs \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@google-cloud/storage": "^9.0.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/diffs": "1.6.4",
    "axios": "^1.21.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.6",
    "cuid": "^3.0.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.57.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "playwright-core": "^1.65.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "winston": "^3.19.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "ts-node": "^10.9.2"
  },
  "license": "MIT"
}
